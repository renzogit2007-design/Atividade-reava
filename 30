programa
{
	funcao inicio()
	{
		real indice

		leia(indice)

		se(indice >= 0.5)
		{
			escreva("Todos os grupos devem paralisar as atividades")
		}
		senao se(indice >= 0.4)
		{
			escreva("Grupos 1 e 2 devem suspender as atividades")
		}
		senao se(indice >= 0.3)
		{
			escreva("Grupo 1 deve suspender as atividades")
		}
		senao
		{
			escreva("Indice aceitavel")
		}
	}
}
